<h2 style="font-size:16px">History (append-only audit log)</h2>
<table>
  <tr><th>When</th><th>Actor</th><th>Action</th><th>Reason</th><th>Before → After</th><th>Request id</th></tr>
  <% if (history.length === 0) { %>
    <tr><td colspan="6" class="muted">No audit entries yet.</td></tr>
  <% } %>
  <% history.forEach(function (entry) { %>
    <tr>
      <td><%= entry.created_at %></td>
      <td><%= entry.actor_id %> <span class="muted">(<%= entry.actor_role %>)</span></td>
      <td><code><%= entry.action %></code></td>
      <td><%= entry.reason || '-' %></td>
      <td>
        <pre class="muted"><%= entry.before_json || '-' %></pre>
        <pre><%= entry.after_json || '-' %></pre>
      </td>
      <td class="muted"><code><%= entry.request_id.slice(0, 8) %></code></td>
    </tr>
  <% }); %>
</table>
